#!/usr/bin/env python3

import re
import subprocess

nwids = subprocess.getoutput('ifconfig iwn0 scan')

nwids = nwids.splitlines();

nwids = list(map(lambda nwid : re.search(r'nwid\s+(.*?)\s+chan\b', nwid), nwids))

nwids = list(filter(lambda nwid : nwid != None, nwids))

nwids = list(map(lambda match : match.group(1), nwids))

nwids = list(filter(lambda nwid : nwid != '""', nwids))

for nwid in nwids:
    print(nwid)

